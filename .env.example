# Copy to .env and adjust. Never commit real secrets.
POSTGRES_USER=docintake
POSTGRES_PASSWORD=docintake
POSTGRES_DB=docintake
DATABASE_URL=postgresql+psycopg://docintake:docintake@postgres:5432/docintake

RABBITMQ_DEFAULT_USER=docintake
RABBITMQ_DEFAULT_PASS=docintake
BROKER_URL=amqp://docintake:docintake@rabbitmq:5672//

# At least 32 bytes. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-value-of-32-bytes-or-more
SEED_PASSWORD=docintake-demo
FLOWER_BASIC_AUTH=admin:admin
GRAFANA_ADMIN_PASSWORD=admin

LOG_LEVEL=INFO
LOG_JSON=true
